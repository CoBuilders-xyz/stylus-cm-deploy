{
  "name": "stylus-cache-manager-hardhat-examples",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone Hardhat 3 examples for caching and activating Stylus programs on Arbitrum Sepolia",
  "scripts": {
    "cache": "hardhat run --no-compile scripts/cache.ts",
    "activate": "hardhat run --no-compile scripts/activate.ts",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.0.15",
    "@types/node": "22.20.0",
    "dotenv": "17.4.2",
    "ethers": "6.17.0",
    "hardhat": "3.15.0",
    "typescript": "6.0.3"
  }
}
