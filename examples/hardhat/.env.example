# Public RPC endpoints can be rate limited. Replace this with your provider if needed.
ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Use a disposable, funded Arbitrum Sepolia wallet. Never commit the real value.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Set this separately for each demo. Activation and caching require different states.
STYLUS_CONTRACT_ADDRESS=0xYOUR_STYLUS_CONTRACT_ADDRESS

# Optional: cache.ts uses the current minimum bid when this is empty. Amount is wei.
CACHE_BID_WEI=

# Optional: maximum value used only to simulate activation and discover its data fee.
ACTIVATION_FEE_CEILING_ETH=0.01
